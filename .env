# ── Football Live Stream API (RapidAPI) — SOURCES DE FLUX UNIQUEMENT ──
# Colle ici la clé RapidAPI (onglet "Endpoints" → X-RapidAPI-Key).
RAPIDAPI_KEY=
# Plafond dur d'appels par jour (le forfait BASIC est très limité).
FLS_DAILY_QUOTA=50
# Appels/jour réservés au rafraîchissement de la liste /all-match.
# Laisser vide = 12% du quota. Le reste sert aux lectures /link/{id}.
FLS_LIST_RESERVE=
# Durée de vie d'un lien de flux en cache (minutes).
FLS_LINK_TTL_MIN=120
# Fenêtre horaire UTC pendant laquelle la liste peut être rafraîchie.
FLS_WINDOW_START=10
FLS_WINDOW_END=23
# proxy = le serveur relaie tout le flux (sûr, mais consomme de la bande passante)
# relay = seul le manifeste passe par nous, les segments partent en 302 vers le CDN
FLS_MODE=proxy
